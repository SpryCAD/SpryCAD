<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
      <!-- geometry code is hot from the first rebuild: skip unoptimized tier-0 JIT (ReadyToRun code is still used) -->
    <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FeatherCad.Kernel\FeatherCad.Kernel.csproj" />
    <ProjectReference Include="..\..\src\FeatherCad.Core\FeatherCad.Core.csproj" />
  </ItemGroup>

</Project>
