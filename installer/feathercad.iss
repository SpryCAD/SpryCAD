; Inno Setup script for FeatherCAD. Build with build\make-installer.ps1, which publishes the app into
; ..\publish\win-x64, generates the demo parts into ..\publish\demos, and passes the version from git in (iscc /DAppVer=0.0.1-dev.3 /DAppVerNum=0.0.1.3). Produces FeatherCAD_setup_v<version>.exe in ..\publish.
;
; The app is published self-contained, so the PC needs no .NET runtime.
; Installs for the current user by default (no admin prompt); the first page offers "all users" instead.
; Settings, recent files and autosave live per user in %APPDATA%\FeatherCAD, so they survive upgrades and uninstall.

; the version comes from git (make-installer.ps1); these only let the script compile on its own
#ifndef AppVer
  #define AppVer "0.0.0-dev"
#endif
; the numeric x.y.z.n form Windows needs for file versions
#ifndef AppVerNum
  #define AppVerNum "0.0.0.0"
#endif
#define AppName "FeatherCAD"
#define AppExe "FeatherCAD.exe"
#define ProgId "FeatherCAD.Part"
; Explorer thumbnail handler (shell\FeatherCadThumbs, built by build\make-thumbs.ps1): its COM class id
#define ThumbClsid "{{7176CCFF-2CCE-451E-BDB2-EFD093B1801B}"
#define ThumbDll "FeatherCadThumbs.dll"

[Setup]
AppId={{6B0E3D7A-4C2F-4E8B-9A51-3F7D2C8E1B64}
AppName={#AppName}
AppVersion={#AppVer}
AppVerName={#AppName} {#AppVer}
AppPublisher=Kurt Jacobson
AppPublisherURL=https://github.com/KurtJacobson/FeatherCAD
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
LicenseFile=..\LICENSE
OutputDir=..\publish
OutputBaseFilename=FeatherCAD_setup_v{#AppVer}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
SetupIconFile=..\src\FeatherCad.App\Assets\FeatherCAD.ico
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
VersionInfoVersion={#AppVerNum}
; Explorer refreshes .fcad icons after install and uninstall.
ChangesAssociations=yes
CloseApplications=yes

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Additional shortcuts:"; Flags: unchecked
Name: "associate"; Description: "Open .fcad &part files with FeatherCAD"; GroupDescription: "File types:"

[Files]
Source: "..\publish\win-x64\*"; DestDir: "{app}"; Excludes: "{#ThumbDll}"; Flags: recursesubdirs ignoreversion
; Explorer's thumbnail process may hold the handler open: replaced (or removed) at the next restart if so
Source: "..\publish\win-x64\{#ThumbDll}"; DestDir: "{app}"; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "..\samples\*.fcad"; DestDir: "{app}\samples"; Flags: ignoreversion
; Generated by make-installer.ps1 from tests/FeatherCad.Tests/Demos.cs
Source: "..\publish\demos\*.fcad"; DestDir: "{app}\samples\demos"; Flags: ignoreversion

[InstallDelete]
; A clean app folder on upgrade, so files a newer version no longer ships do not linger.
Type: filesandordirs; Name: "{app}\*"

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon

[Registry]
; HKA is HKCU for a per-user install and HKLM for all users.
Root: HKA; Subkey: "Software\Classes\.fcad"; ValueType: string; ValueName: ""; ValueData: "{#ProgId}"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.fcad\OpenWithProgids"; ValueType: string; ValueName: "{#ProgId}"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\{#ProgId}"; ValueType: string; ValueName: ""; ValueData: "FeatherCAD Part"; Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\{#ProgId}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#AppExe},0"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\{#ProgId}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExe}"" ""%1"""; Tasks: associate
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExe}\SupportedTypes"; ValueType: string; ValueName: ".fcad"; ValueData: ""; Flags: uninsdeletekey
; Explorer thumbnails: the preview image saved inside container parts (plain JSON parts keep the icon)
Root: HKA; Subkey: "Software\Classes\CLSID\{#ThumbClsid}"; ValueType: string; ValueName: ""; ValueData: "FeatherCAD Thumbnail Handler"; Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\CLSID\{#ThumbClsid}\InprocServer32"; ValueType: string; ValueName: ""; ValueData: "{app}\{#ThumbDll}"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\CLSID\{#ThumbClsid}\InprocServer32"; ValueType: string; ValueName: "ThreadingModel"; ValueData: "Apartment"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.fcad\ShellEx\{{e357fccd-a995-4576-b01f-234630154e96}"; ValueType: string; ValueName: ""; ValueData: "{#ThumbClsid}"; Flags: uninsdeletekey; Tasks: associate

[Run]
Filename: "{app}\{#AppExe}"; Description: "Launch {#AppName}"; Flags: postinstall nowait skipifsilent
