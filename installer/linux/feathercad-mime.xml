<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-feathercad-part">
    <comment>FeatherCAD part</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.fcprt"/>
    <icon name="application-x-feathercad-part"/>
  </mime-type>
  <mime-type type="application/x-feathercad-assembly">
    <comment>FeatherCAD assembly</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.fcasm"/>
    <icon name="application-x-feathercad-assembly"/>
  </mime-type>
</mime-info>
