; Inno Setup script for SpryCAD. Build with build\make-installer.ps1, which publishes the app into
; ..\publish\win-x64, generates the demo parts into ..\publish\demos, and passes the version from git in (iscc /DAppVer=0.0.1-dev.3 /DAppVerNum=0.0.1.3). Produces SpryCAD_setup_v<version>.exe in ..\publish.
;
; The app is published self-contained, so the PC needs no .NET runtime.
; Installs for the current user by default (no admin prompt); the first page offers "all users" instead.
; Settings, recent files and autosave live per user in %APPDATA%\SpryCAD, so they survive upgrades and uninstall.

; the version comes from git (make-installer.ps1); these only let the script compile on its own
#ifndef AppVer
  #define AppVer "0.0.0-dev"
#endif
; the numeric x.y.z.n form Windows needs for file versions
#ifndef AppVerNum
  #define AppVerNum "0.0.0.0"
#endif
#define AppName "SpryCAD"
#define AppExe "SpryCAD.exe"
#define ProgId "SpryCAD.Part"
#define StepProgId "SpryCAD.Step"
#define AsmProgId "SpryCAD.Assembly"
; Explorer thumbnail handler (shell\SpryCadThumbs, built by build\make-thumbs.ps1): its COM class id
#define ThumbClsid "{{2F5A5D18-E9B5-4929-90DF-C338D2FA19B5}"
#define ThumbDll "SpryCadThumbs.dll"

[Setup]
AppId={{2FC56716-8B82-427F-B14D-4F7386ECF289}
AppName={#AppName}
AppVersion={#AppVer}
AppVerName={#AppName} {#AppVer}
AppPublisher=Kurt Jacobson
AppPublisherURL=https://github.com/SpryCAD/SpryCAD
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
LicenseFile=..\LICENSE
OutputDir=..\publish
OutputBaseFilename=SpryCAD_setup_v{#AppVer}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
SetupIconFile=..\src\SpryCad.App\Assets\SpryCAD.ico
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
VersionInfoVersion={#AppVerNum}
; Explorer refreshes .sprt icons after install and uninstall.
ChangesAssociations=yes
CloseApplications=yes

[Tasks]
Name: "desktopicon"; Description: "Create a &desktop shortcut"; GroupDescription: "Additional shortcuts:"; Flags: unchecked
Name: "associate"; Description: "Open .sprt &part and .sasm assembly files with SpryCAD"; GroupDescription: "File types:"
Name: "stepopenwith"; Description: "Offer SpryCAD in ""Open with"" for &STEP files (.step, .stp)"; GroupDescription: "File types:"

[Files]
Source: "..\publish\win-x64\*"; DestDir: "{app}"; Excludes: "{#ThumbDll}"; Flags: recursesubdirs ignoreversion
; Explorer's thumbnail process may hold the handler open: replaced (or removed) at the next restart if so
Source: "..\publish\win-x64\{#ThumbDll}"; DestDir: "{app}"; Flags: ignoreversion restartreplace uninsrestartdelete
; the file type icons
Source: "..\src\SpryCad.App\Assets\SpryCADPart.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\src\SpryCad.App\Assets\SpryCADAssembly.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\samples\*.sprt"; DestDir: "{app}\samples"; Flags: ignoreversion
; Generated by make-installer.ps1 from tests/SpryCad.Tests/Demos.cs
Source: "..\publish\demos\*.sprt"; DestDir: "{app}\samples\demos"; Flags: ignoreversion
Source: "..\publish\demos\*.sasm"; DestDir: "{app}\samples\demos"; Flags: ignoreversion

[InstallDelete]
; A clean app folder on upgrade, so files a newer version no longer ships do not linger.
Type: filesandordirs; Name: "{app}\*"

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon

[Registry]
; HKA is HKCU for a per-user install and HKLM for all users.
Root: HKA; Subkey: "Software\Classes\.sprt"; ValueType: string; ValueName: ""; ValueData: "{#ProgId}"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.sprt\OpenWithProgids"; ValueType: string; ValueName: "{#ProgId}"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\{#ProgId}"; ValueType: string; ValueName: ""; ValueData: "SpryCAD Part"; Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\{#ProgId}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\SpryCADPart.ico"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\{#ProgId}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExe}"" ""%1"""; Tasks: associate
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExe}\SupportedTypes"; ValueType: string; ValueName: ".sprt"; ValueData: ""; Flags: uninsdeletekey
; assemblies (.sasm)
Root: HKA; Subkey: "Software\Classes\.sasm"; ValueType: string; ValueName: ""; ValueData: "{#AsmProgId}"; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.sasm\OpenWithProgids"; ValueType: string; ValueName: "{#AsmProgId}"; ValueData: ""; Flags: uninsdeletevalue; Tasks: associate
Root: HKA; Subkey: "Software\Classes\{#AsmProgId}"; ValueType: string; ValueName: ""; ValueData: "SpryCAD Assembly"; Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\{#AsmProgId}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\SpryCADAssembly.ico"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\{#AsmProgId}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExe}"" ""%1"""; Tasks: associate
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExe}\SupportedTypes"; ValueType: string; ValueName: ".sasm"; ValueData: ""
; STEP files: SpryCAD is offered under "Open with" (it imports the model into a new part), without taking over
; the default program another CAD package may own; the user can still pick SpryCAD and "Always" there.
Root: HKA; Subkey: "Software\Classes\{#StepProgId}"; ValueType: string; ValueName: ""; ValueData: "STEP Model"; Flags: uninsdeletekey; Tasks: stepopenwith
Root: HKA; Subkey: "Software\Classes\{#StepProgId}\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\{#AppExe},0"; Tasks: stepopenwith
Root: HKA; Subkey: "Software\Classes\{#StepProgId}\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExe}"" ""%1"""; Tasks: stepopenwith
Root: HKA; Subkey: "Software\Classes\.step\OpenWithProgids"; ValueType: string; ValueName: "{#StepProgId}"; ValueData: ""; Flags: uninsdeletevalue; Tasks: stepopenwith
Root: HKA; Subkey: "Software\Classes\.stp\OpenWithProgids"; ValueType: string; ValueName: "{#StepProgId}"; ValueData: ""; Flags: uninsdeletevalue; Tasks: stepopenwith
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExe}\SupportedTypes"; ValueType: string; ValueName: ".step"; ValueData: ""; Tasks: stepopenwith
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExe}\SupportedTypes"; ValueType: string; ValueName: ".stp"; ValueData: ""; Tasks: stepopenwith
; Explorer thumbnails: the preview image saved inside container parts (plain JSON parts keep the icon)
Root: HKA; Subkey: "Software\Classes\CLSID\{#ThumbClsid}"; ValueType: string; ValueName: ""; ValueData: "SpryCAD Thumbnail Handler"; Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\CLSID\{#ThumbClsid}\InprocServer32"; ValueType: string; ValueName: ""; ValueData: "{app}\{#ThumbDll}"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\CLSID\{#ThumbClsid}\InprocServer32"; ValueType: string; ValueName: "ThreadingModel"; ValueData: "Apartment"; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.sprt\ShellEx\{{e357fccd-a995-4576-b01f-234630154e96}"; ValueType: string; ValueName: ""; ValueData: "{#ThumbClsid}"; Flags: uninsdeletekey; Tasks: associate
Root: HKA; Subkey: "Software\Classes\.sasm\ShellEx\{{e357fccd-a995-4576-b01f-234630154e96}"; ValueType: string; ValueName: ""; ValueData: "{#ThumbClsid}"; Flags: uninsdeletekey; Tasks: associate

[Run]
Filename: "{app}\{#AppExe}"; Description: "Launch {#AppName}"; Flags: postinstall nowait skipifsilent
