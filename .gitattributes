# Shell scripts and Linux desktop files run on Linux: keep LF in every checkout
*.sh text eol=lf
*.desktop text eol=lf
installer/linux/*.xml text eol=lf
*.py text eol=lf

# Workbooks (the built-in library: data/library): binary, shown as their cells by git diff once a clone sets up the
# xlsx driver (docs/library-v2.md, "The built-in library")
*.xlsx binary diff=xlsx
