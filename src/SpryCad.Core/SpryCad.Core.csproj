<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- SQLite (Storage/SqliteSetup.cs picks which): the system's on Linux, the bundled build elsewhere (the app's
       Linux builds leave it out: SpryCad.App.csproj). The bundled build is pinned
       past 2.1.11, which has a high-severity advisory (GHSA-2m69-gcr7-jv3q). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" Version="2.1.12" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>

  <!-- SpryCAD's built-in library (docs/library-v2.md): authored as workbooks in data/library, checked and turned into
       JSON by tools/SpryCad.LibraryGen before this project compiles, and embedded (Library/LibraryDefaults.cs). A bad
       cell fails the build, named by its workbook, sheet and cell. -->
  <PropertyGroup>
    <LibraryGenDll>$(MSBuildThisFileDirectory)..\..\tools\SpryCad.LibraryGen\bin\$(Configuration)\net10.0\SpryCad.LibraryGen.dll</LibraryGenDll>
    <LibraryDataOut>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)library-defaults\$(Configuration)\</LibraryDataOut>
  </PropertyGroup>
  <ItemGroup>
    <LibraryData Include="..\..\data\library\*.xlsx" />
    <EmbeddedResource Include="@(LibraryData->'$(LibraryDataOut)%(Filename).json')" LogicalName="LibraryDefaults/%(Filename).json" />
  </ItemGroup>
  <!-- (the generator built as a step of its own, not referenced, so nothing of it lands beside what references Core;
       without the app's runtime, so its output is where LibraryGenDll says; nor the publish settings, as a ReadyToRun
       publish would pick a runtime for it again) -->
  <Target Name="BuildLibraryGen" BeforeTargets="PrepareResources">
    <MSBuild Projects="..\..\tools\SpryCad.LibraryGen\SpryCad.LibraryGen.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;TargetFramework;OutDir;OutputPath;_IsPublishing;PublishReadyToRun;PublishSingleFile;PublishTrimmed;PublishAot" />
  </Target>
  <Target Name="GenerateLibraryDefaults" DependsOnTargets="BuildLibraryGen" BeforeTargets="PrepareResources"
          Inputs="@(LibraryData);$(LibraryGenDll)" Outputs="@(LibraryData->'$(LibraryDataOut)%(Filename).json')">
    <Exec Command="dotnet &quot;$(LibraryGenDll)&quot; gen &quot;$(LibraryDataOut.TrimEnd('\'))&quot; @(LibraryData->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\SpryCad.Kernel\SpryCad.Kernel.csproj" />
    <!-- shop profile tables in libraries (Library/LibraryFile.cs) -->
    <ProjectReference Include="..\SpryCad.SheetMetal.Core\SpryCad.SheetMetal.Core.csproj" />
    <ProjectReference Include="..\SpryCad.Library\SpryCad.Library.csproj" />
  </ItemGroup>

</Project>
