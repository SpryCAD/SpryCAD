<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SpryCAD.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>SpryCAD</AssemblyName>
    <!-- no Version here: it comes from git (target SpryCadGitVersion below) -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>SpryCAD</Product>
    <RootNamespace>SpryCad.App</RootNamespace>
    <TieredPGO>true</TieredPGO>
    <!-- a GC heap per core (sized to the load: .NET's dynamic adaptation), collected by all of them at once: parts built
         in parallel no longer wait on one thread's collections (a large STEP assembly's parts built in 1.1 s, were 1.55; ~20 MB
         more at rest) -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- QuickJit stays on (the default): with ReadyToRun, turning it off made startup ~280 ms slower and the first
         rebuild no faster, as everything not precompiled had to be fully optimized before it first ran -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="11.3.9.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drawn by build/make-icon.ps1 -->
    <AvaloniaResource Include="Assets\**" />
    <!-- the icons (Icons/README.md): drawn as SVG, read by UI/Icons.cs -->
    <EmbeddedResource Include="Icons\*.svg" LogicalName="Icons/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpryCad.Core\SpryCad.Core.csproj" />
  </ItemGroup>

  <!--
    Where the app looks for updates (Updater.cs): the packages' public URL and the channel, from the environment
    the packages workflow sets. A build without them (a local one) never checks.
  -->
  <ItemGroup Condition="'$(SPRYCAD_UPDATE_URL)' != '' And '$(SPRYCAD_UPDATE_CHANNEL)' != ''">
    <AssemblyMetadata Include="UpdateUrl" Value="$(SPRYCAD_UPDATE_URL)" />
    <AssemblyMetadata Include="UpdateChannel" Value="$(SPRYCAD_UPDATE_CHANNEL)" />
  </ItemGroup>

  <!--
    The version, from git on every build (dev runs too), as the packages get it (build/make-installer.ps1,
    make-linux-package.sh): on the tag v0.0.1 it is 0.0.1, three commits later 0.0.1-dev.3. The file version is
    0.0.1.3, and the informational version (shown in Help > About) adds the commit: 0.0.1-dev.3+aeb382f, with
    ".dirty" when built with uncommitted changes. Without git or a v<x.y.z> tag: 0.0.0-dev.
  -->
  <Target Name="SpryCadGitVersion" BeforeTargets="GetAssemblyVersion">
    <Exec Command="git describe --tags --match &quot;v[0-9]*&quot; --long --dirty" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribe" />
    </Exec>
    <PropertyGroup>
      <_GitPattern>^v(\d+\.\d+\.\d+)-(\d+)-g([0-9a-f]+)(-dirty)?$</_GitPattern>
      <_GitOk>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitDescribe)', '$(_GitPattern)'))</_GitOk>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_GitOk)' == 'True'">
      <_GitBase>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitPattern)', '$1'))</_GitBase>
      <_GitHeight>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitPattern)', '$2'))</_GitHeight>
      <_GitHash>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitPattern)', '$3'))</_GitHash>
      <_GitDirty>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitPattern)', '$4'))</_GitDirty>
      <Version Condition="'$(_GitHeight)' == '0'">$(_GitBase)</Version>
      <Version Condition="'$(_GitHeight)' != '0'">$(_GitBase)-dev.$(_GitHeight)</Version>
      <FileVersion>$(_GitBase).$(_GitHeight)</FileVersion>
      <InformationalVersion>$(Version)+$(_GitHash)</InformationalVersion>
      <InformationalVersion Condition="'$(_GitDirty)' != ''">$(InformationalVersion).dirty</InformationalVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_GitOk)' != 'True'">
      <Version>0.0.0-dev</Version>
      <FileVersion>0.0.0.0</FileVersion>
      <InformationalVersion>0.0.0-dev</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- Linux builds use the system's SQLite (libsqlite3.so.0, a package dependency): the bundled library is left out,
       as it needs a newer glibc than the packages promise (build/make-linux-package.sh checks). -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" ExcludeAssets="native" />
  </ItemGroup>

</Project>
