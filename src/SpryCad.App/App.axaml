<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SpryCad.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SpryCAD/UI/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- a fixed accent (check boxes, radio buttons, focus lines, list selections) rather than the system's, so the
         app looks the same on every PC; the menu check boxes (MainWindow.Commands.cs) take it from here too. It is
         the palette's Spry.Accent (UI/Palette.axaml), so the theme's controls match the app's own selections -->
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FF2F7BD6" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://SpryCAD/UI/Styles.axaml" />
  </Application.Styles>
</Application>
