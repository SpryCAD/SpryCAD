<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vp="using:SpryCad.App.Viewport"
        xmlns:ui="using:SpryCad.App.UI"
        x:Class="SpryCad.App.MainWindow"
        Title="SpryCAD"
        Icon="avares://SpryCAD/Assets/SpryCAD.ico"
        Width="1400" Height="880"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource Spry.Window}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- Menu bar + quick access -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Spry.Surface}" BorderBrush="{DynamicResource Spry.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="SpryCAD" FontWeight="Bold" Foreground="{DynamicResource Spry.Brand}" VerticalAlignment="Center" Margin="10,0,8,0" FontSize="{x:Static ui:TypeScale.Header}" />
        <StackPanel x:Name="QuickAccess" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0" />
        <Menu x:Name="MainMenu" />
      </DockPanel>
    </Border>

    <!-- CommandManager -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Spry.SurfaceAlt}" BorderBrush="{DynamicResource Spry.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel x:Name="CommandTabs" DockPanel.Dock="Bottom" Orientation="Horizontal" Background="{DynamicResource Spry.Strip}" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="CommandBar" Orientation="Horizontal" Height="62" Margin="4,3" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Spry.Strip}" BorderBrush="{DynamicResource Spry.Border}" BorderThickness="0,1,0,0" Height="24">
      <DockPanel Margin="8,0">
        <TextBlock x:Name="StatusUnits" DockPanel.Dock="Right" Text="MMGS" VerticalAlignment="Center" Margin="12,0,0,0" Width="44" TextAlignment="Center" Foreground="{DynamicResource Spry.TextSecondary}" />
        <TextBlock x:Name="StatusSketch" DockPanel.Dock="Right" Text="" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusCoords" DockPanel.Dock="Right" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Spry.TextSecondary}" />
        <TextBlock x:Name="StatusRebuild" DockPanel.Dock="Right" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Spry.TextMuted}" />
        <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="{DynamicResource Spry.Text}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Document tabs: one per open part, as many as fit; the button at the right lists them all (MainWindow.Tabs.cs) -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Spry.Strip}" BorderBrush="{DynamicResource Spry.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button x:Name="PartsButton" DockPanel.Dock="Right" Margin="2,3,4,3" Padding="8,1" MinHeight="0" FontSize="{x:Static ui:TypeScale.Body}"
                Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource Spry.BorderStrong}" VerticalAlignment="Center" />
        <ui:TabStripPanel x:Name="DocTabs" Margin="4,3,4,0" Spacing="2" ClipToBounds="True" />
      </DockPanel>
    </Border>

    <Grid x:Name="MainGrid" ColumnDefinitions="290,4,*,0,0,Auto">
      <!-- Left panel: FeatureManager / PropertyManager -->
      <Border Grid.Column="0" Background="{DynamicResource Spry.Panel}" BorderBrush="{DynamicResource Spry.Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <!-- the left panel's tabs (MainWindow.Commands.cs, AddPanelTab); all panels stay loaded, one shows -->
          <TabStrip x:Name="PanelTabs" DockPanel.Dock="Top" Classes="paneltabs" />
          <Panel x:Name="PanelHost">
            <ui:FeatureTree x:Name="Tree" />
            <ContentControl x:Name="PmHost" IsVisible="False" Background="{DynamicResource Spry.Panel}" />
          </Panel>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Background="{DynamicResource Spry.StripItem}" ResizeDirection="Columns" />

      <!-- Graphics area -->
      <Grid Grid.Column="2" x:Name="GraphicsArea">
        <vp:ViewportControl x:Name="Viewport" />
        <Canvas x:Name="Overlay" ClipToBounds="True" />
        <!-- heads-up view toolbar -->
        <Border Classes="hud" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
          <StackPanel x:Name="HudBar" Orientation="Horizontal" />
        </Border>
        <!-- the flyout design tree (MainWindow.FlyoutTree.cs): while the panel shows something else; no backing, as
             SolidWorks', so only its rows take the mouse and the model shows through around them -->
        <Border x:Name="FlyoutHost" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6,0,0" IsVisible="False" />
        <!-- confirmation corner -->
        <Border x:Name="ConfirmCorner" Classes="hud" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0" IsVisible="False">
          <StackPanel Orientation="Horizontal" x:Name="ConfirmBar" />
        </Border>
        <!-- triad labels + rebuild indicator -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" IsHitTestVisible="False">
          <TextBlock x:Name="BusyText" Text="Rebuilding…" VerticalAlignment="Center" Foreground="{DynamicResource Spry.TextMuted}" IsVisible="False" />
          <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Width="60" MinWidth="0" Height="4" MinHeight="0" VerticalAlignment="Center" IsVisible="{Binding #BusyText.IsVisible}" />
        </StackPanel>
        <TextBlock x:Name="ViewName" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="96,0,0,8" Foreground="{DynamicResource Spry.TextMuted}" FontStyle="Italic" />
      </Grid>

      <!-- the task pane (MainWindow.TaskPane.cs), as SolidWorks': unpinned, it slides out over the graphics area
           (TaskOverlay); pinned, it takes the columns 3 and 4 (0 wide otherwise); its tabs are the strip at the right -->
      <Panel x:Name="TaskOverlay" Grid.Column="2" ZIndex="10" />
      <GridSplitter x:Name="TaskSplitter" Grid.Column="3" Background="{DynamicResource Spry.StripItem}" ResizeDirection="Columns" IsVisible="False" />
      <ContentControl x:Name="TaskPinHost" Grid.Column="4" />
      <Border Grid.Column="5" Background="{DynamicResource Spry.Strip}" BorderBrush="{DynamicResource Spry.Border}" BorderThickness="1,0,0,0">
        <StackPanel x:Name="TaskStrip" Margin="2,4" Spacing="2" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
