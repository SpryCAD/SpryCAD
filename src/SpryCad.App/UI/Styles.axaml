<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:SpryCad.App.UI">

  <!-- CommandManager large buttons -->
  <Style Selector="Button.cmd">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button.cmd:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Spry.HoverBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.HoverBorder}" />
  </Style>
  <Style Selector="Button.cmd.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Spry.SelectedBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.SelectedBorder}" />
  </Style>
  <Style Selector="Button.cmd TextBlock">
    <Setter Property="FontSize" Value="{x:Static ui:TypeScale.Body}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Spry.Text}" />
  </Style>
  <Style Selector="Button.cmd:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Spry.TextDisabled}" />
  </Style>
  <Style Selector="Button.cmd:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- a command family's button (MainWindow.CommandLayout.cs): hovered, a grid of the family drops below it -->
  <Style Selector="Border.cmdgrid">
    <Setter Property="Background" Value="{DynamicResource Spry.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <!-- the row's buttons and the grid's, one size: the icon above the name -->
  <Style Selector="Button.cmd.big">
    <Setter Property="Width" Value="88" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Padding" Value="4,5,4,3" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <!-- names broken in code (MainWindow.BarLabel), every one two lines high: a tab of one-line names is no shorter -->
  <Style Selector="Button.cmd.big TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="15" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.cmd.big.iconsonly">
    <Setter Property="Width" Value="48" />
  </Style>
  <Style Selector="UniformGrid > Button.cmd.big">
    <Setter Property="Margin" Value="1" />
  </Style>
  <!-- a command family's button: the command used last, and at its right an arrow dropping the family's grid; under the
       pointer the two outlined as one, a line between them, each part lit as it is pointed at -->
  <Style Selector="Border.splitbox">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.splitbox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.HoverBorder}" />
  </Style>
  <Style Selector="Border.splitbox Border.splitdivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.splitbox:pointerover Border.splitdivider">
    <Setter Property="Background" Value="{DynamicResource Spry.HoverBorder}" />
  </Style>
  <Style Selector="Border.splitbox Button.cmd">
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.splitbox Button.cmd.drop">
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cmdgridhead">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Spry.TextSecondary}" />
    <Setter Property="Margin" Value="4,0,0,2" />
  </Style>

  <!-- small toolbar buttons -->
  <Style Selector="Button.tb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button.tb:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Spry.HoverBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.HoverBorder}" />
  </Style>
  <Style Selector="Button.tb.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Spry.SelectedBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.SelectedBorder}" />
  </Style>
  <!-- disabled: no fill (the theme's grey made an unavailable Undo look pressed), the icon faded instead -->
  <Style Selector="Button.tb:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tb:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- the buttons of a card (UI/Card.cs) and a dialog's OK / Cancel (UI/Dialogs.cs): the one with the keyboard has a
       ring (Enter presses it), blue, or dark blue on the blue default button. The ring is the button's own border
       (2 wide, clear until focused, the fill under it), so it keeps the rounded corners, the button keeps its
       size and nothing moves when the ring goes from button to button -->
  <Style Selector="Button.card">
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.card /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.card:focus /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.Accent}" />
  </Style>
  <Style Selector="Button.card.accent:focus /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.AccentText}" />
  </Style>

  <!-- the Mate page's list of mate types: flat rows, the chosen one highlighted as a tree row is -->
  <Style Selector="ToggleButton.matetype">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="{x:Static ui:TypeScale.Body}" />
  </Style>
  <Style Selector="ToggleButton.matetype:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Spry.HoverBg}" />
  </Style>
  <Style Selector="ToggleButton.matetype:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Spry.SelectedBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Spry.SelectedText}" />
  </Style>
  <Style Selector="ToggleButton.matetype:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="ToggleButton.matetype.framed">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.BorderStrong}" />
  </Style>
  <Style Selector="ToggleButton.matetype.framed:checked /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.Accent}" />
  </Style>
  <Style Selector="ToggleButton.matetype:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- CommandManager tabs -->
  <Style Selector="ToggleButton.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="12,3" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="{x:Static ui:TypeScale.Body}" />
  </Style>
  <Style Selector="ToggleButton.tab:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Spry.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Spry.AccentText}" />
  </Style>
  <!-- tabs below what they switch (the CommandManager's): the line along their top, against it -->
  <Style Selector="ToggleButton.tab.below">
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>

  <!-- left panel tabs (FeatureManager / PropertyManager / ...): compact icon tabs; the selected one is white,
       with the theme's selection line under it -->
  <Style Selector="TabStrip.paneltabs">
    <Setter Property="Background" Value="{DynamicResource Spry.Strip}" />
  </Style>
  <Style Selector="TabStrip.paneltabs TabStripItem">
    <Setter Property="Padding" Value="8,4,8,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <!-- own template: the selection line is the tab's bottom edge, where it joins the panel below
         (the theme's sits just under the content) -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabStrip.paneltabs TabStripItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource Spry.HoverBg}" />
  </Style>
  <Style Selector="TabStrip.paneltabs TabStripItem:selected">
    <Setter Property="Background" Value="{DynamicResource Spry.Panel}" />
  </Style>
  <Style Selector="TabStrip.paneltabs TabStripItem:selected /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.Accent}" />
  </Style>

  <!-- PropertyManager -->
  <Style Selector="Border.pmsection">
    <Setter Property="Background" Value="{DynamicResource Spry.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Margin" Value="4,3" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <!-- a value on a page: a plain tinted rectangle (white with the accent while typed in); red when it does not evaluate
       (.invalid) or the feature fails with it (.failed) -->
  <Style Selector="Border.pmsection TextBox">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Spry.FieldBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.FieldBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,3" />
  </Style>
  <Style Selector="Border.pmsection TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Spry.FieldBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.HoverBorder}" />
  </Style>
  <Style Selector="Border.pmsection TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Spry.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.pmsection TextBox.invalid, Border.pmsection TextBox.failed">
    <Setter Property="Background" Value="{DynamicResource Spry.DangerBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.Danger}" />
  </Style>
  <Style Selector="Border.pmsection TextBox.invalid:pointerover /template/ Border#PART_BorderElement, Border.pmsection TextBox.failed:pointerover /template/ Border#PART_BorderElement, Border.pmsection TextBox.invalid:focus /template/ Border#PART_BorderElement, Border.pmsection TextBox.failed:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Spry.DangerBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.Danger}" />
  </Style>
  <Style Selector="TextBlock.pmheader">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Spry.Heading}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="ListBox.selbox">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MaxHeight" Value="140" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.FieldBorder}" />
    <Setter Property="Background" Value="{DynamicResource Spry.SurfaceAlt}" />
  </Style>
  <!-- the active box (what is clicked goes in): the theme's blue, as selections are everywhere else -->
  <Style Selector="ListBox.selbox.activebox">
    <Setter Property="Background" Value="{DynamicResource Spry.HoverBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.Accent}" />
  </Style>
  <!-- an entry selected in a box: the tree's selection blue -->
  <Style Selector="ListBox.selbox ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Spry.SelectedBg}" />
    <Setter Property="Foreground" Value="{DynamicResource Spry.SelectedText}" />
  </Style>
  <Style Selector="ListBox.selbox ListBoxItem">
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="MinHeight" Value="20" />
  </Style>

  <!-- Feature tree -->
  <Style Selector="Border.treerow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Border.treerow:pointerover">
    <Setter Property="Background" Value="{DynamicResource Spry.HoverBg}" />
  </Style>
  <!-- the feature that owns the face/edge selected in the graphics area (not a tree selection) -->
  <Style Selector="Border.treerow.related">
    <Setter Property="Background" Value="{DynamicResource Spry.HoverBg}" />
  </Style>
  <Style Selector="Border.treerow.selected">
    <Setter Property="Background" Value="{DynamicResource Spry.SelectedBg}" />
  </Style>

  <!-- heads-up toolbar -->
  <Style Selector="Border.hud">
    <Setter Property="Background" Value="{DynamicResource Spry.Hud}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Spry.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="2" />
  </Style>
</Styles>
