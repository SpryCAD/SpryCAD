      "expr": "6"
    },
    {
      "name": "NLH",
      "expr": "6"
    },
    {
      "name": "r",
      "expr": "m*z/2"
    },
    {
      "name": "rb",
      "expr": "r*cos(PA)"
    },
    {
      "name": "ra",
      "expr": "r\u002Bm"
    },
    {
      "name": "rf",
      "expr": "r-1.25*m"
    },
    {
      "name": "inva",
      "expr": "tan(PA)-PA*pi/180"
    },
    {
      "name": "rs",
      "expr": "max(rb, rf\u002B0.1*m)"
    },
    {
      "name": "re",
      "expr": "ra\u002B0.3*m"
    },
    {
      "name": "HubD",
      "expr": "2.2*Bore"
    },
    {
      "name": "RimD",
      "expr": "2*rf-4*m"
    },
    {
      "name": "Pocket",
      "expr": "(b-Web)/2"
    },
    {
      "name": "LH",
      "expr": "0.7*(RimD-HubD)/2"
    },
    {
      "name": "LHR",
      "expr": "(RimD\u002BHubD)/4"
    }
  ],
